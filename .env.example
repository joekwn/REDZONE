# REDZONE settings for running on your own computer.
# Copy the lines you need into your shell (PowerShell:  $env:NAME = "value").
# Never commit real values: .env files are ignored by git.

# NASA FIRMS key (free): https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=

# Email(s) of accounts allowed to use the admin tools (comma separated)
REDZONE_ADMIN_EMAILS=

# Contact address shown on /privacy and /terms
REDZONE_CONTACT_EMAIL=

# Optional: use a MotherDuck cloud database instead of data/redzone.duckdb
# REDZONE_DB=md:redzone_cloud
# MOTHERDUCK_TOKEN=

# Optional: hours between automatic FIRMS updates (default 3)
# REDZONE_UPDATE_HOURS=3
