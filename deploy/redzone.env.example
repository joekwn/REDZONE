# REDZONE settings - this file lives at /etc/redzone/redzone.env on the server.
# After editing:  sudo systemctl restart redzone

# NASA FIRMS key (live updates, past data, look-ups)
FIRMS_MAP_KEY=

# Email address(es) of REDZONE accounts that may use admin tools (comma separated)
REDZONE_ADMIN_EMAILS=

# Contact address shown on /privacy and /terms and sent to OpenStreetMap services
REDZONE_CONTACT_EMAIL=

# Public address of the site (set automatically by setup.sh)
REDZONE_BASE_URL=https://example.sslip.io

# The app runs behind Caddy on the same server: trust its X-Forwarded-For header
REDZONE_TRUST_PROXY=1

# How often to download new FIRMS data (hours) and the pause between past-data requests (seconds)
REDZONE_UPDATE_HOURS=3
REDZONE_BACKFILL_PAUSE=2

# Email is off while SMTP_HOST is empty (no verification, no email features)
SMTP_HOST=
